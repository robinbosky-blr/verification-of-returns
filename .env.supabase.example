# Copy this file to .env.supabase and replace every placeholder.
# Never commit .env.supabase or a Supabase secret key.

# Dashboard > Connect > Session pooler is recommended for IPv4 development machines.
# Keep sslmode=require. Percent-encode reserved characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_DATABASE_PASSWORD@REPLACE_POOLER_HOST:5432/postgres?sslmode=require

# Existing ReturnScope application login. Use at least 12 characters.
ADMIN_PASSWORD=replace-with-a-long-development-password
COOKIE_SECURE=false
HTTP_PORT=8088

# Private Supabase Storage bucket. Create this bucket before starting the app.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=returns-originals
