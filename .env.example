# Required. Set long, unique passwords before the first start.
POSTGRES_PASSWORD=replace-with-a-long-database-password
ADMIN_PASSWORD=replace-with-a-long-workspace-password
# Local Docker: http://localhost:8088. Set true behind HTTPS.
COOKIE_SECURE=false
HTTP_PORT=8088
# Optional S3-compatible storage. Empty endpoint uses the persistent uploads volume.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SECURE=true
